# --- Base de données (Postgres) ---
# En local tu peux lancer Postgres avec Docker :
#   docker run --name solayia-db -e POSTGRES_PASSWORD=solayia -e POSTGRES_DB=solayia -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:solayia@localhost:5432/solayia?schema=public"

# --- Auth.js (NextAuth) ---
# Génère une clé avec : openssl rand -base64 32
AUTH_SECRET="change-moi-en-production"

# URL publique de l'application (utile en prod)
# AUTH_URL="https://portail.solayia.fr"
